# === 각 에이전트를 서로 다른 LLM 제공사로 배정 (여러 AI 협업 구조) ===
# crewai는 내부적으로 litellm을 사용하므로, provider/model-name 형식을 그대로 쓰면 됨.
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# 에이전트별 모델 (비워두면 기본값 사용)
LITERATURE_MODEL=anthropic/claude-sonnet-4-5   # 문헌 검토 담당
DATA_MODEL=openai/gpt-4o                       # 데이터 분석 담당
REPORT_MODEL=gemini/gemini-1.5-pro             # 종합 보고서 담당
MANAGER_MODEL=anthropic/claude-opus-4-1        # 작업 배분을 담당하는 매니저 AI

# 문헌 검색 도구 (둘 중 하나만 있어도 됨, 없어도 arXiv 검색은 동작함)
SERPER_API_KEY=your_serper_key_here      # crewai_tools SerperDevTool용
TAVILY_API_KEY=your_tavily_key_here      # 대안 검색 API
